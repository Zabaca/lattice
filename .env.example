# Lattice reads environment variables, not this file. These are the ones that
# matter; CLAUDE.md lists them all.

# Where Lattice keeps its notes, index and model weights (default ~/.lattice).
# LATTICE_HOME=~/.lattice

# Embeddings run on this machine with no API key. `hash` is the deterministic
# provider the tests use.
# LATTICE_EMBED_PROVIDER=local

# Reranking is off unless you name a reranker.
# LATTICE_RERANK_PROVIDER=jev
# TYPESAFE_API_KEY=your-typesafe-api-key-here
